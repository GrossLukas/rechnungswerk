@if (Invoice.SentAt is not null)
{
    <span class="status status-done">Versendet</span>
}
else if (Invoice.LastMailError is not null)
{
    <span class="status status-error">Versand fehlgeschlagen</span>
}
else
{
    <span class="status">Entwurf</span>
}

@code {
    [Parameter, EditorRequired]
    public Invoice Invoice { get; set; } = default!;
}
