@if (Invoice.SentAt is not null)
{
    <span class="badge badge-success" title="@($"Versendet am {Display.Timestamp(Invoice.SentAt)} an {Invoice.SentTo}")">Versendet</span>
}
else if (Invoice.LastMailError is not null)
{
    <span class="badge badge-danger" title="@Invoice.LastMailError">Versand fehlgeschlagen</span>
}
else
{
    <span class="badge badge-neutral">Nicht versendet</span>
}

@code {
    [Parameter, EditorRequired]
    public Invoice Invoice { get; set; } = default!;
}
