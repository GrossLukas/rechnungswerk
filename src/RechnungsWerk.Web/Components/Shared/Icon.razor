@* Schlichte Strich-Symbole (24er-Raster), Farbe kommt aus dem Text. *@
<svg class="icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    @switch (Name)
    {
        case "view":
            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
            <circle cx="12" cy="12" r="3" />
            break;
        case "check":
            <circle cx="12" cy="12" r="9" />
            <path d="m8 12.5 2.8 2.8L16.5 9.5" />
            break;
        case "invoice":
            <path d="M6 3h9l4 4v14H6z" />
            <path d="M15 3v4h4M9 12h7M9 16h7" />
            break;
        case "people":
            <circle cx="9" cy="8" r="3.5" />
            <path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5M16 4.8a3.5 3.5 0 0 1 0 6.4M18.5 14.9c1.5.8 2.6 2.5 3 5.1" />
            break;
        case "tag":
            <path d="M3 12.6V4h8.6l9 9-8.6 8.6z" />
            <circle cx="7.5" cy="8.5" r="1.2" />
            break;
        case "settings":
            <path d="M4 7h9M17 7h3M4 17h3M11 17h9" />
            <circle cx="15" cy="7" r="2" />
            <circle cx="9" cy="17" r="2" />
            break;
        case "logout":
            <path d="M14 4h5v16h-5M10 8l-4 4 4 4M6 12h10" />
            break;
        case "login":
            <path d="M10 4H5v16h5M14 8l4 4-4 4M18 12H8" />
            break;
        case "upload":
            <path d="M12 16V4M7 9l5-5 5 5M4 16v4h16v-4" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";
}
