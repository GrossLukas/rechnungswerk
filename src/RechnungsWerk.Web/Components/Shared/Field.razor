@typeparam TValue
@using System.Linq.Expressions

@* Kurzes Label über dem Eingabefeld; Fehler stehen direkt darunter und nur, wenn es wirklich einen gibt. Sie stehen
   im Label: So gehören sie zum Feld, und Screenreader lesen sie mit dem Feldnamen vor, sobald das Feld den Fokus hat. *@
<div class="field @(string.IsNullOrEmpty(Error) ? null : "has-error")">
    <label>
        <span class="field-label">@Label</span>
        @ChildContent
        @if (For is not null)
        {
            <ValidationMessage For="For" />
        }
        @if (!string.IsNullOrEmpty(Error))
        {
            <span class="field-error">@Error</span>
        }
    </label>
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public Expression<Func<TValue>>? For { get; set; }

    /// <summary>Meldung aus der Fachprüfung, die keine DataAnnotation ist (z. B. „Den Kunden gibt es nicht mehr“).</summary>
    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
