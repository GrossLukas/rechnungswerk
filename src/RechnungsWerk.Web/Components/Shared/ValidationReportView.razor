@* Ergebnis der offiziellen Prüfung durch den KoSIT-Validator. *@
<section class="report" aria-live="polite">
    <p class="verdict @(Report.IsAcceptable ? "verdict-ok" : "verdict-fail")">
        <span aria-hidden="true">@(Report.IsAcceptable ? "✓" : "✕")</span>
        @(Report.IsAcceptable ? "Gültig" : "Nicht gültig")
    </p>

    @if (!Report.ScenarioMatched)
    {
        <p class="form-error">
            Kein passendes Prüfszenario: Geprüft werden XRechnung (UBL, CII) und ZUGFeRD/Factur-X im Profil EN 16931.
            Die Profile MINIMUM und BASIC WL gelten in Deutschland nicht als E-Rechnung.
        </p>
    }

    @if (Report.Messages.Count > 0)
    {
        <ol class="findings">
            @foreach (var message in Report.Messages.OrderBy(m => m.Level))
            {
                <li class="finding finding-@Css(message.Level)">
                    <p class="finding-title">
                        @if (!string.IsNullOrWhiteSpace(message.RuleId))
                        {
                            <span class="rule-id">@message.RuleId</span>
                        }
                        @message.Explanation
                    </p>
                    <p class="finding-text">@message.Text</p>
                    @if (!string.IsNullOrWhiteSpace(message.Location))
                    {
                        <p class="finding-text mono">@message.Location</p>
                    }
                </li>
            }
        </ol>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public ValidationReport Report { get; set; } = default!;

    private static string Css(ValidationLevel level) => level switch
    {
        ValidationLevel.Error => "error",
        ValidationLevel.Warning => "warning",
        _ => "info",
    };
}
