@* Ergebnis der offiziellen Prüfung durch den KoSIT-Validator. *@
<section class="report" aria-live="polite">
    <div class="verdict @(Report.IsAcceptable ? "verdict-ok" : "verdict-fail")">
        <span class="verdict-icon" aria-hidden="true">@(Report.IsAcceptable ? "✓" : "✕")</span>
        <div>
            <p class="verdict-title">
                @(Report.IsAcceptable ? "Gültig – die Rechnung erfüllt die Vorgaben." : "Nicht gültig – die Rechnung erfüllt die Vorgaben nicht.")
            </p>
            <p class="verdict-sub">
                Prüfszenario: @(Report.ScenarioName ?? "keines gefunden")
                · @Report.ErrorCount Fehler
                · @Report.WarningCount @(Report.WarningCount == 1 ? "Warnung" : "Warnungen")
            </p>
        </div>
    </div>

    @if (!Report.ScenarioMatched)
    {
        <p class="alert alert-warning">
            Für diese Datei gibt es kein passendes Prüfszenario. Meist ist es keine XRechnung bzw. kein EN-16931-Profil
            (z. B. ZUGFeRD BASIC oder MINIMUM) – solche Dateien gelten in Deutschland nicht als E-Rechnung.
        </p>
    }

    @if (Report.Steps.Count > 0)
    {
        <ul class="step-list">
            @foreach (var step in Report.Steps)
            {
                <li class="@(step.Valid ? "step-ok" : "step-fail")">
                    <span aria-hidden="true">@(step.Valid ? "✓" : "✕")</span>
                    @step.Name
                    <span class="visually-hidden">@(step.Valid ? "bestanden" : "nicht bestanden")</span>
                </li>
            }
        </ul>
    }

    @foreach (var group in Groups)
    {
        <h3>@group.Title (@group.Messages.Count)</h3>
        <ol class="findings">
            @foreach (var message in group.Messages)
            {
                <li class="finding finding-@group.Css">
                    <p class="finding-head">
                        @if (!string.IsNullOrWhiteSpace(message.RuleId))
                        {
                            <span class="rule-id">@message.RuleId</span>
                        }
                        <span>@message.Explanation</span>
                    </p>
                    <p class="finding-text">@message.Text</p>
                    @if (!string.IsNullOrWhiteSpace(message.Location))
                    {
                        <p class="finding-location">Fundstelle: <code>@message.Location</code></p>
                    }
                </li>
            }
        </ol>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public ValidationReport Report { get; set; } = default!;

    private IEnumerable<(string Title, string Css, IReadOnlyList<ValidationMessage> Messages)> Groups
    {
        get
        {
            foreach (var (level, title, css) in new[]
                     {
                         (ValidationLevel.Error, "Fehler", "error"),
                         (ValidationLevel.Warning, "Warnungen", "warning"),
                         (ValidationLevel.Information, "Hinweise", "info"),
                     })
            {
                var messages = Report.Messages.Where(m => m.Level == level).ToList();
                if (messages.Count > 0)
                {
                    yield return (title, css, messages);
                }
            }
        }
    }
}
