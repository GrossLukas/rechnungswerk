@if (Errors is { Count: > 0 })
{
    <div class="alert alert-error" role="alert">
        @if (Errors.Count == 1)
        {
            <p>@Errors[0]</p>
        }
        else
        {
            <p><strong>Bitte prüfe deine Angaben:</strong></p>
            <ul>
                @foreach (var error in Errors)
                {
                    <li>@error</li>
                }
            </ul>
        }
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<string>? Errors { get; set; }
}
