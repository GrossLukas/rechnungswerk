<div class="upload-box @(Busy ? "is-busy" : null)">
    <InputFile id="@Id" OnChange="OnChange" disabled="@Busy" aria-describedby="@($"{Id}-hint")"
               accept=".xml,.pdf,application/xml,text/xml,application/pdf" />
    <label for="@Id">
        <svg class="upload-icon" viewBox="0 0 24 24" width="32" height="32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 16V4" />
            <path d="m7 9 5-5 5 5" />
            <path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" />
        </svg>
        <span class="upload-title">@(Busy ? BusyText : Title)</span>
        <span class="upload-hint" id="@($"{Id}-hint")">XRechnung (UBL oder CII) als XML oder ZUGFeRD/Factur-X als PDF · höchstens 10 MB</span>
    </label>
</div>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = "";

    [Parameter]
    public string Title { get; set; } = "Datei auswählen oder hierher ziehen";

    [Parameter]
    public string BusyText { get; set; } = "Wird verarbeitet …";

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback<InputFileChangeEventArgs> OnChange { get; set; }
}
