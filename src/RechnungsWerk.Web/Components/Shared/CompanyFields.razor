@* Felder des Firmenprofils – in der Ersteinrichtung und in den Einstellungen. *@
<fieldset class="section">
    <legend>Firma</legend>
    <Field Label="Name" For="() => Model.Name"><InputText @bind-Value="Model.Name" autocomplete="organization" /></Field>
    <Field Label="Straße" For="() => Model.Street"><InputText @bind-Value="Model.Street" autocomplete="street-address" /></Field>
    <div class="field-row">
        <Field Label="PLZ" For="() => Model.PostalCode"><InputText @bind-Value="Model.PostalCode" autocomplete="postal-code" inputmode="numeric" /></Field>
        <Field Label="Ort" For="() => Model.City"><InputText @bind-Value="Model.City" autocomplete="address-level2" /></Field>
    </div>
    <Field Label="Land" For="() => Model.CountryCode"><InputText @bind-Value="Model.CountryCode" maxlength="2" autocomplete="country" /></Field>
</fieldset>

<fieldset class="section">
    <legend>Steuer</legend>
    <Field Label="USt-IdNr." For="() => Model.VatId"><InputText @bind-Value="Model.VatId" /></Field>
    <Field Label="Steuernummer" For="() => Model.TaxNumber"><InputText @bind-Value="Model.TaxNumber" /></Field>
    <label class="check">
        <InputCheckbox @bind-Value="Model.IsSmallBusiness" />
        <span>Kleinunternehmer (§ 19 UStG)</span>
    </label>
</fieldset>

<fieldset class="section">
    <legend>Kontakt</legend>
    <Field Label="Ansprechperson" For="() => Model.ContactName"><InputText @bind-Value="Model.ContactName" autocomplete="name" /></Field>
    <Field Label="Telefon" For="() => Model.Phone"><InputText type="tel" @bind-Value="Model.Phone" autocomplete="tel" /></Field>
    <Field Label="E-Mail" For="() => Model.Email"><InputText type="email" @bind-Value="Model.Email" autocomplete="email" /></Field>
</fieldset>

<fieldset class="section">
    <legend>Bank</legend>
    <Field Label="IBAN" For="() => Model.Iban"><InputText @bind-Value="Model.Iban" autocomplete="off" spellcheck="false" /></Field>
    <Field Label="BIC" For="() => Model.Bic"><InputText @bind-Value="Model.Bic" autocomplete="off" spellcheck="false" /></Field>
    <Field Label="Bank" For="() => Model.BankName"><InputText @bind-Value="Model.BankName" /></Field>
</fieldset>

<fieldset class="section">
    <legend>Rechnungen</legend>
    @* Vorsatz, laufende Nummer und was daraus wird in einer Zeile: Die Vorschau gehört ins Raster, nicht als Nebenzeile darunter. *@
    <div class="field-row field-row-3">
        <Field Label="Nummer beginnt mit" For="() => Model.InvoiceNumberPrefix"><InputText @bind-Value="Model.InvoiceNumberPrefix" spellcheck="false" /></Field>
        <Field Label="Nächste Nummer" For="() => Model.NextInvoiceNumber"><InputNumber @bind-Value="Model.NextInvoiceNumber" min="1" ParsingErrorMessage="Bitte gib eine ganze Zahl ein." /></Field>
        <div class="field">
            <span class="field-label" id="next-invoice-number">Nächste Rechnung</span>
            <output class="field-value mono" aria-labelledby="next-invoice-number">@InvoiceService.FormatNumber(Model.InvoiceNumberPrefix, Model.NextInvoiceNumber, DateTime.Today.Year)</output>
        </div>
    </div>
    <Field Label="Zahlungsziel (Tage)" For="() => Model.DefaultPaymentDays"><InputNumber @bind-Value="Model.DefaultPaymentDays" min="0" max="365" ParsingErrorMessage="Bitte gib eine ganze Zahl ein." /></Field>
    <Field Label="Format" For="() => Model.DefaultFormat">
        <InputSelect @bind-Value="Model.DefaultFormat">
            @foreach (var format in Enum.GetValues<EInvoiceFormat>())
            {
                <option value="@format">@format.Label()</option>
            }
        </InputSelect>
    </Field>
</fieldset>

@code {
    [Parameter, EditorRequired]
    public CompanyForm Model { get; set; } = default!;
}
