<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.Public.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <p class="alert alert-warning" role="alert">Bitte <a href="anmelden">melde dich an</a>, um diese Seite zu sehen.</p>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
