@page "/anmelden"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject SetupService Setup
@inject NavigationManager Navigation

<PageTitle>Anmelden – RechnungsWerk</PageTitle>

<PageHeader Title="Anmelden" />

<EditForm Model="Input" method="post" OnValidSubmit="LoginAsync" FormName="login" novalidate class="form">
    <ModelValidator />
    <Field Label="E-Mail" For="() => Input.Email"><InputText type="email" @bind-Value="Input.Email" autocomplete="username" /></Field>
    <Field Label="Passwort" For="() => Input.Password"><InputText type="password" @bind-Value="Input.Password" autocomplete="current-password" /></Field>
    <FormErrors Messages="@(error is null ? null : [error])" />
    <div class="form-actions">
        <button type="submit" class="button button-primary">Anmelden</button>
    </div>
</EditForm>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "login")]
    private LoginForm Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new LoginForm();

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            if (await Setup.IsSetupRequiredAsync())
            {
                Navigation.NavigateTo("einrichtung");
                return;
            }

            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    private async Task LoginAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(Input.Email.Trim(), Input.Password, isPersistent: false, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            Navigation.NavigateTo(LocalUrl.SafeReturnUrl(ReturnUrl));
            return;
        }

        // Passwörter nie zurück in die Seite schreiben.
        Input.Password = "";
        error = result.IsLockedOut
            ? "Zu viele Fehlversuche. Das Konto ist für 15 Minuten gesperrt."
            : "E-Mail oder Passwort stimmen nicht.";
    }

    private sealed class LoginForm
    {
        [Display(Name = "E-Mail"), Required(ErrorMessage = "Bitte gib deine E-Mail-Adresse ein.")]
        public string Email { get; set; } = "";

        [Display(Name = "Passwort"), Required(ErrorMessage = "Bitte gib dein Passwort ein.")]
        public string Password { get; set; } = "";
    }
}
