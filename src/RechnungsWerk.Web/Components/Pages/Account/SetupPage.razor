@page "/einrichtung"
@rendermode InteractiveServer
@inject SetupService Setup
@inject SetupCodeStore SetupCode
@inject NavigationManager Navigation

<PageTitle>Einrichten – RechnungsWerk</PageTitle>

@if (loading)
{
    <PageHeader Title="Einrichten" />
}
else if (!setupRequired)
{
    <PageHeader Title="Bereits eingerichtet" />
    <EmptyState Text="Melde dich mit deinem Konto an." ActionText="Anmelden" ActionHref="anmelden" />
}
else
{
    <PageHeader Title="Einrichten" />

    @* Meldungen aus dem Dienst gelten nur für den Versuch, der sie ausgelöst hat. *@
    <EditForm Model="form" OnValidSubmit="CompleteAsync" OnInvalidSubmit="() => result = null" novalidate class="form">
        <ModelValidator Include="[form.Company]" />

        <fieldset class="section">
            <legend>Zugang</legend>
            <Field Label="Einrichtungscode" For="() => form.SetupCode" Error="@result?.ErrorFor(nameof(SetupForm.SetupCode))">
                <InputText @bind-Value="form.SetupCode" autocomplete="off" spellcheck="false" class="mono" />
            </Field>
            <Field Label="E-Mail" For="() => form.Email" Error="@result?.ErrorFor(nameof(SetupForm.Email))">
                <InputText type="email" @bind-Value="form.Email" autocomplete="username" />
            </Field>
            <Field Label="Passwort" For="() => form.Password" Error="@result?.ErrorFor(nameof(SetupForm.Password))">
                <InputText type="password" @bind-Value="form.Password" autocomplete="new-password" />
            </Field>
            <Field Label="Passwort wiederholen" For="() => form.ConfirmPassword">
                <InputText type="password" @bind-Value="form.ConfirmPassword" autocomplete="new-password" />
            </Field>
        </fieldset>

        <CompanyFields Model="form.Company" />

        <FormErrors Messages="result?.GeneralErrors" />
        <div class="form-actions">
            <button type="submit" class="button button-primary" disabled="@saving">Einrichten</button>
        </div>
    </EditForm>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private readonly SetupForm form = new();
    private ServiceResult? result;
    private bool loading = true;
    private bool setupRequired;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        setupRequired = await Setup.IsSetupRequiredAsync();
        if (!setupRequired && AuthenticationState is not null && (await AuthenticationState).User.Identity?.IsAuthenticated == true)
        {
            // Wer schon angemeldet ist, landet bei der Arbeit statt bei „Melde dich an“.
            Navigation.NavigateTo("rechnungen");
            return;
        }

        if (setupRequired)
        {
            // Wurde die Code-Datei gelöscht, entsteht hier ein neuer Code.
            SetupCode.EnsureCreated();
        }

        loading = false;
    }

    private async Task CompleteAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        result = null;
        result = await Setup.CompleteAsync(form);
        if (result.Succeeded)
        {
            // Gesperrt lassen, bis die Anmeldung geladen ist.
            Navigation.NavigateTo("anmelden", forceLoad: true);
            return;
        }

        saving = false;
    }
}
