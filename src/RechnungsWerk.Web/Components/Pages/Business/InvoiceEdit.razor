@page "/rechnungen/neu"
@page "/rechnungen/{Id:int}/bearbeiten"
@rendermode AppRenderModes.Live
@inject InvoiceService Invoices
@inject CompanyService Companies
@inject CustomerService Customers
@inject ArticleService Articles
@inject NavigationManager Navigation

<DocumentTitle Text="@Title" />

@if (loading)
{
    return;
}

@if (blocker is not null)
{
    <PageHeader Title="@Title" />
    <EmptyState Text="@blocker.Value.Text" ActionText="@blocker.Value.ActionText" ActionHref="@blocker.Value.ActionHref" />
    return;
}

<PageHeader Title="@Title" />

<EditForm Model="form" OnSubmit="SaveAsync" novalidate class="form form-invoice">
    <Field Label="Kunde" For="() => form.CustomerId" Error="@Error(nameof(InvoiceForm.CustomerId))">
        <InputSelect Value="form.CustomerId" ValueChanged="(int? id) => SelectCustomer(id)" ValueExpression="() => form.CustomerId">
            <option value=""></option>
            @foreach (var customer in customers)
            {
                <option value="@customer.Id">@customer.Name</option>
            }
        </InputSelect>
    </Field>

    <Field Label="Rechnungsdatum" For="() => form.IssueDate"><InputDate @bind-Value="form.IssueDate" ParsingErrorMessage="Bitte gib ein Datum ein." /></Field>

    <fieldset class="choice">
        <legend class="field-label">Leistung</legend>
        <InputRadioGroup @bind-Value="form.ServiceMode">
            <label class="check"><InputRadio Value="ServiceDateMode.Date" /><span>an einem Tag</span></label>
            <label class="check"><InputRadio Value="ServiceDateMode.Period" /><span>über einen Zeitraum</span></label>
        </InputRadioGroup>
    </fieldset>
    @if (form.ServiceMode == ServiceDateMode.Date)
    {
        <Field Label="Leistungsdatum" For="() => form.DeliveryDate" Error="@Error(nameof(InvoiceForm.DeliveryDate))">
            <InputDate @bind-Value="form.DeliveryDate" ParsingErrorMessage="Bitte gib ein Datum ein." />
        </Field>
    }
    else
    {
        <div class="field-row">
            <Field Label="Von" For="() => form.ServicePeriodStart" Error="@Error(nameof(InvoiceForm.ServicePeriodStart))">
                <InputDate @bind-Value="form.ServicePeriodStart" ParsingErrorMessage="Bitte gib ein Datum ein." />
            </Field>
            <Field Label="Bis" For="() => form.ServicePeriodEnd" Error="@Error(nameof(InvoiceForm.ServicePeriodEnd))">
                <InputDate @bind-Value="form.ServicePeriodEnd" ParsingErrorMessage="Bitte gib ein Datum ein." />
            </Field>
        </div>
    }

    <Field Label="Fällig am" For="() => form.DueDate" Error="@Error(nameof(InvoiceForm.DueDate))"><InputDate @bind-Value="form.DueDate" ParsingErrorMessage="Bitte gib ein Datum ein." /></Field>

    <section class="lines @(smallBusiness ? "no-vat" : null)" aria-label="Positionen">
        <div class="lines-head" aria-hidden="true">
            <span>Position</span>
            <span class="num">Menge</span>
            <span>Einheit</span>
            <span class="num">Preis</span>
            @if (!smallBusiness)
            {
                <span>USt</span>
            }
            <span class="num">Betrag</span>
            <span></span>
        </div>
        <ol class="lines-list">
            @for (var i = 0; i < form.Lines.Count; i++)
            {
                var index = i;
                var line = form.Lines[index];
                var number = index + 1;
                <li class="line" @key="line">
                    <div class="line-texts">
                        <label><span class="line-label">Bezeichnung</span><InputText @bind-Value="line.Name" placeholder="Bezeichnung" /></label>
                        <label><span class="line-label">Beschreibung</span><InputText @bind-Value="line.Description" placeholder="Beschreibung" class="line-desc-input" /></label>
                    </div>
                    <label class="line-cell"><span class="line-label">Menge</span><DecimalInput @bind-Value="line.Quantity" DisplayName="Menge" class="num" /></label>
                    <label class="line-cell"><span class="line-label">Einheit</span><InputSelect @bind-Value="line.UnitCode">
                        @foreach (var (unitCode, unitLabel) in UnitCodes.Common)
                        {
                            <option value="@unitCode">@unitLabel</option>
                        }
                    </InputSelect></label>
                    <label class="line-cell"><span class="line-label">Preis</span><DecimalInput @bind-Value="line.UnitPrice" DisplayName="Preis" class="num" /></label>
                    @if (!smallBusiness)
                    {
                        <label class="line-cell"><span class="line-label">USt</span><InputSelect @bind-Value="line.VatRate">
                            @foreach (var rate in VatRates.Allowed)
                            {
                                <option value="@rate">@rate %</option>
                            }
                        </InputSelect></label>
                    }
                    <span class="line-cell"><span class="line-label">Betrag</span><output class="num line-amount">@GermanFormat.Money(Money.Round(line.Quantity * line.UnitPrice))</output></span>
                    <button type="button" class="button button-icon" @onclick="() => RemoveLine(index)" disabled="@(form.Lines.Count == 1)"
                            aria-label="@($"Position {number} entfernen")">✕</button>
                    @if (LineError(index) is { } lineError)
                    {
                        <p class="field-error line-error" role="alert">@lineError</p>
                    }
                    <ValidationMessage For="() => line.Quantity" />
                    <ValidationMessage For="() => line.UnitPrice" />
                </li>
            }
        </ol>
        <div class="lines-actions">
            <button type="button" class="button button-plain" @onclick="AddLine">+ Position</button>
            @if (articles.Count > 0)
            {
                <select @bind="articlePick" @bind:after="AddArticle" aria-label="Artikel übernehmen">
                    <option value="">+ Artikel</option>
                    @foreach (var article in articles)
                    {
                        <option value="@article.Id">@article.Name</option>
                    }
                </select>
            }
        </div>
        <FormErrors Messages="@(Error(nameof(InvoiceForm.Lines)) is { } linesError ? [linesError] : null)" />

        <dl class="totals-list editor-totals">
            <div><dt>Netto</dt><dd>@GermanFormat.Money(Calculation.LineTotal)</dd></div>
            @foreach (var tax in Calculation.Taxes.Where(t => t.CategoryCode != InvoiceCalculator.Exempt))
            {
                <div><dt>USt @GermanFormat.Percent(tax.Rate)</dt><dd>@GermanFormat.Money(tax.TaxAmount)</dd></div>
            }
            <div class="total-due"><dt>Gesamt</dt><dd>@GermanFormat.Money(Calculation.GrandTotal)</dd></div>
        </dl>
    </section>

    @if (!smallBusiness && form.Lines.Any(l => l.VatRate == 0))
    {
        <Field Label="Grund der Steuerbefreiung" For="() => form.TaxExemptionReason" Error="@Error(nameof(InvoiceForm.TaxExemptionReason))">
            <InputText @bind-Value="form.TaxExemptionReason" />
        </Field>
    }

    <details class="more" open="@moreOpen">
        <summary>Weitere Angaben</summary>
        <Field Label="Käuferreferenz" For="() => form.BuyerReference" Error="@Error(nameof(InvoiceForm.BuyerReference))"><InputText @bind-Value="form.BuyerReference" /></Field>
        <Field Label="Bestellnummer" For="() => form.OrderReference" Error="@Error(nameof(InvoiceForm.OrderReference))"><InputText @bind-Value="form.OrderReference" /></Field>
        <Field Label="Zahlungsbedingungen" For="() => form.PaymentTerms" Error="@Error(nameof(InvoiceForm.PaymentTerms))">
            <InputText @bind-Value="form.PaymentTerms" placeholder="@InvoiceService.DefaultPaymentTerms(form.DueDate)" />
        </Field>
        <Field Label="Hinweis" For="() => form.Note" Error="@Error(nameof(InvoiceForm.Note))"><InputTextArea @bind-Value="form.Note" rows="3" /></Field>
        <Field Label="Versandformat" For="() => form.PreferredFormat">
            <InputSelect @bind-Value="form.PreferredFormat">
                @foreach (var format in Enum.GetValues<EInvoiceFormat>())
                {
                    <option value="@format">@format.Label()</option>
                }
            </InputSelect>
        </Field>
    </details>

    <FormErrors Messages="result?.GeneralErrors" />
    <div class="form-actions">
        <button type="submit" class="button button-primary" aria-disabled="@(saving ? "true" : null)">Speichern</button>
    </div>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private static readonly string[] MoreFields =
        [nameof(InvoiceForm.BuyerReference), nameof(InvoiceForm.OrderReference), nameof(InvoiceForm.PaymentTerms), nameof(InvoiceForm.Note)];

    private InvoiceForm form = new();
    private List<Customer> customers = [];
    private List<Article> articles = [];
    private ServiceResult? result;
    private (string Text, string ActionText, string ActionHref)? blocker;
    private string? number;
    private string articlePick = "";
    private bool smallBusiness;
    private bool loading = true;
    private bool saving;
    private bool moreOpen;

    private string Title => Id is null ? "Neue Rechnung" : number ?? "Rechnung";

    private InvoiceCalculation Calculation =>
        InvoiceCalculator.Calculate(form.ToItems(smallBusiness), smallBusiness, form.TaxExemptionReason);

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        blocker = null;
        var profile = await Companies.GetAsync();
        if (profile is null)
        {
            blocker = ("Lege zuerst dein Firmenprofil an.", "Zum Firmenprofil", "einstellungen/firma");
            loading = false;
            return;
        }

        smallBusiness = profile.IsSmallBusiness;
        customers = await Customers.ListAsync();
        articles = await Articles.ListAsync();

        if (Id is { } id)
        {
            var invoice = await Invoices.GetAsync(id);
            if (invoice is null)
            {
                blocker = ("Diese Rechnung gibt es nicht mehr.", "Zu den Rechnungen", "rechnungen");
            }
            else if (invoice.IsLocked)
            {
                // Versendete Rechnungen sind festgeschrieben.
                blocker = ("Versendete Rechnungen lassen sich nicht mehr ändern.", "Zur Rechnung", $"rechnungen/{invoice.Id}");
                number = invoice.Number;
            }
            else
            {
                form = InvoiceForm.From(invoice);
                number = invoice.Number;
            }
        }
        else if (customers.Count == 0)
        {
            blocker = ("Lege zuerst einen Kunden an.", "Neuer Kunde", "kunden/neu");
        }
        else
        {
            form = Invoices.NewForm(profile);
        }

        loading = false;
    }

    private string? Error(string field) => result?.ErrorFor(field);

    private string? LineError(int index)
    {
        var prefix = $"{nameof(InvoiceForm.Lines)}[{index}].";
        var messages = result?.Problems.Where(p => p.Field?.StartsWith(prefix, StringComparison.Ordinal) == true).Select(p => p.Message).ToList();
        return messages is { Count: > 0 } ? string.Join(" ", messages) : null;
    }

    private void SelectCustomer(int? id)
    {
        var previous = customers.FirstOrDefault(c => c.Id == form.CustomerId);
        form.CustomerId = id;
        var customer = customers.FirstOrDefault(c => c.Id == id);

        // Den Vorschlag des vorigen Kunden ersetzen, eine eigene Eingabe aber behalten.
        if (string.IsNullOrWhiteSpace(form.BuyerReference) || form.BuyerReference == previous?.BuyerReference)
        {
            form.BuyerReference = customer?.BuyerReference;
        }

        if (customer is not null && Id is null && !string.IsNullOrWhiteSpace(customer.LeitwegId))
        {
            // Behörden erwarten in aller Regel XRechnung.
            form.PreferredFormat = EInvoiceFormat.XRechnungUbl;
        }
    }

    private void AddLine()
    {
        form.Lines.Add(new InvoiceLineForm { VatRate = smallBusiness ? 0 : 19 });
        FocusAfterRender(".lines-list > li:last-child input");
    }

    private void RemoveLine(int index)
    {
        if (form.Lines.Count > 1)
        {
            form.Lines.RemoveAt(index);
            result = null;
            // Weiter an der Nachbarzeile; bleibt nur eine (ohne Entfernen), an „+ Position“.
            FocusAfterRender(form.Lines.Count > 1
                ? $".lines-list > li:nth-child({Math.Min(index, form.Lines.Count - 1) + 1}) .button-icon"
                : ".lines-actions .button-plain");
        }
    }

    private void AddArticle()
    {
        if (int.TryParse(articlePick, out var articleId) && articles.FirstOrDefault(a => a.Id == articleId) is { } article)
        {
            var line = InvoiceLineForm.FromArticle(article);
            if (smallBusiness)
            {
                line.VatRate = 0;
            }

            // Eine leere Startposition ersetzen statt eine zweite anzuhängen.
            if (form.Lines is [{ Name: "" or null, UnitPrice: 0 }])
            {
                form.Lines.Clear();
            }

            form.Lines.Add(line);
        }

        articlePick = "";
    }

    private async Task SaveAsync(EditContext context)
    {
        // Der Knopf sperrt nur per aria-disabled, damit er den Fokus behält – ein Doppelklick käme sonst zweimal an.
        if (saving)
        {
            return;
        }

        // Ein Feld, das sich nicht lesen ließ (z. B. ein geleertes Datum), behält seinen alten Wert – gespeichert würde
        // sonst nicht, was dasteht.
        if (context.GetValidationMessages().Any())
        {
            FocusFirstErrorAfterRender();
            return;
        }

        saving = true;
        result = await Invoices.SaveAsync(form);
        if (result.Succeeded)
        {
            // Gesperrt lassen, bis der Browser die Rechnung zeigt – sonst vergäbe ein später zweiter Klick eine zweite Nummer.
            Navigation.NavigateTo($"rechnungen/{result.Id}");
            return;
        }

        moreOpen = MoreFields.Any(field => result.ErrorFor(field) is not null);
        saving = false;
        FocusFirstErrorAfterRender();
    }
}
