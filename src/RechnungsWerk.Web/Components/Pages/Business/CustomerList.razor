@page "/kunden"
@rendermode AppRenderModes.Live
@inject CustomerService Customers

<DocumentTitle Text="Kunden" />

<PageHeader Title="Kunden">
    <Action>
        @if (customers is { Count: > 0 })
        {
            <a class="button button-primary" href="kunden/neu">Neuer Kunde</a>
        }
    </Action>
</PageHeader>

@if (customers is null)
{
    return;
}

@if (customers.Count == 0)
{
    <EmptyState Text="Noch keine Kunden." ActionText="Neuer Kunde" ActionHref="kunden/neu" />
}
else
{
    <input type="search" class="search" aria-label="Kunden durchsuchen" placeholder="Suchen" @bind="search" @bind:event="oninput" />
    <ul class="list" role="list">
        @foreach (var customer in Filtered)
        {
            <ListRow Href="@($"kunden/{customer.Id}")" Title="@customer.Name" Detail="@($"{customer.PostalCode} {customer.City}")">
                <Trailing>
                    <span class="row-detail">@(customer.LeitwegId ?? customer.Email)</span>
                </Trailing>
            </ListRow>
        }
    </ul>
    @* Von Anfang an da, damit Screenreader „Keine Treffer“ ansagen. *@
    <div role="status">
        @if (!Filtered.Any())
        {
            <p class="muted">Keine Treffer.</p>
        }
    </div>
}

@code {
    private List<Customer>? customers;
    private string search = "";

    private IEnumerable<Customer> Filtered
    {
        get
        {
            var term = search.Trim();
            return term.Length == 0
                ? customers ?? []
                : (customers ?? []).Where(c => c.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                                               || c.City.Contains(term, StringComparison.OrdinalIgnoreCase)
                                               || (c.Email?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    protected override async Task OnInitializedAsync() => customers = await Customers.ListAsync();
}
