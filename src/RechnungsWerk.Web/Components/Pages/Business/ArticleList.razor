@page "/artikel"
@rendermode AppRenderModes.Live
@inject ArticleService Articles

<PageTitle>Artikel – RechnungsWerk</PageTitle>

<PageHeader Title="Artikel">
    <Action>
        @if (articles is { Count: > 0 })
        {
            <a class="button button-primary" href="artikel/neu">Neuer Artikel</a>
        }
    </Action>
</PageHeader>

@if (articles is null)
{
    return;
}

@if (articles.Count == 0)
{
    <EmptyState Text="Noch keine Artikel." ActionText="Neuer Artikel" ActionHref="artikel/neu" />
}
else
{
    <ul class="list" role="list">
        @foreach (var article in articles)
        {
            <ListRow Href="@($"artikel/{article.Id}")" Title="@article.Name" Detail="@($"{UnitCodes.Label(article.UnitCode)} · {GermanFormat.Percent(article.VatRate)} USt")">
                <Trailing>
                    <span class="amount">@GermanFormat.UnitPrice(article.UnitPrice)</span>
                </Trailing>
            </ListRow>
        }
    </ul>
}

@code {
    private List<Article>? articles;

    protected override async Task OnInitializedAsync() => articles = await Articles.ListAsync();
}
