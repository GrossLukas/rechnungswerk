@page "/einstellungen/versand"
@rendermode AppRenderModes.Live
@using RechnungsWerk.Core.Mail
@inject SmtpSettingsService SmtpSettings
@inject InvoiceMailService Mail
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>Versand – RechnungsWerk</PageTitle>

<PageHeader Title="Einstellungen" />
<SettingsNav />

@if (form is not null)
{
    <EditForm Model="form" OnValidSubmit="SaveAsync" novalidate class="form">
        <ModelValidator />
        <fieldset class="section">
            <legend>SMTP-Server</legend>
            <Field Label="Server" For="() => form.Host"><InputText @bind-Value="form.Host" autocomplete="off" spellcheck="false" /></Field>
            <div class="field-row">
                <Field Label="Verschlüsselung" For="() => form.Security">
                    <InputSelect Value="form.Security" ValueChanged="(SmtpSecurity value) => ChangeSecurity(value)" ValueExpression="() => form.Security">
                        <option value="@SmtpSecurity.StartTls">STARTTLS</option>
                        <option value="@SmtpSecurity.SslOnConnect">SSL/TLS</option>
                        <option value="@SmtpSecurity.None">Keine</option>
                    </InputSelect>
                </Field>
                <Field Label="Port" For="() => form.Port"><InputNumber @bind-Value="form.Port" min="1" max="65535" ParsingErrorMessage="Bitte gib eine ganze Zahl ein." /></Field>
            </div>
            <Field Label="Benutzer" For="() => form.UserName"><InputText @bind-Value="form.UserName" autocomplete="off" spellcheck="false" /></Field>
            <Field Label="@(hasStoredPassword ? "Neues Passwort" : "Passwort")" For="() => form.NewPassword">
                <InputText type="password" @bind-Value="form.NewPassword" autocomplete="new-password" />
            </Field>
            @if (hasStoredPassword)
            {
                <label class="check">
                    <InputCheckbox @bind-Value="form.RemovePassword" />
                    <span>Gespeichertes Passwort entfernen</span>
                </label>
            }
        </fieldset>

        <fieldset class="section">
            <legend>Absender</legend>
            <Field Label="Name" For="() => form.SenderName"><InputText @bind-Value="form.SenderName" /></Field>
            <Field Label="E-Mail" For="() => form.SenderEmail"><InputText type="email" @bind-Value="form.SenderEmail" /></Field>
        </fieldset>

        <fieldset class="section">
            <legend>Nachricht</legend>
            <Field Label="Betreff" For="() => form.SubjectTemplate"><InputText @bind-Value="form.SubjectTemplate" /></Field>
            <Field Label="Text" For="() => form.BodyTemplate"><InputTextArea @bind-Value="form.BodyTemplate" rows="9" /></Field>
        </fieldset>

        <div class="form-actions">
            @if (saved)
            {
                <span class="saved" role="status">Gespeichert</span>
            }
            <button type="submit" class="button button-primary" disabled="@busy">Speichern</button>
        </div>
    </EditForm>

    <section class="section form test-mail" aria-label="Testmail">
        <div class="field-row field-row-action">
            <div class="field">
                <label>
                    <span class="field-label">Testmail an</span>
                    <input type="email" @bind="testRecipient" autocomplete="email" />
                </label>
                @if (testResult?.ErrorFor(InvoiceMailService.RecipientField) is { } recipientError)
                {
                    <p class="field-error" role="alert">@recipientError</p>
                }
            </div>
            <button type="button" class="button button-secondary" @onclick="SendTestAsync" disabled="@busy">@(busy ? "Wird gesendet …" : "Testmail senden")</button>
        </div>
        @if (testResult is { Succeeded: true })
        {
            <p class="saved" role="status">Testmail verschickt</p>
        }
        <FormErrors Messages="testResult?.GeneralErrors" />
    </section>
}

@code {
    private SmtpForm? form;
    private bool hasStoredPassword;
    private string? testRecipient;
    private ServiceResult? testResult;
    private bool busy;
    private bool saved;

    protected override async Task OnInitializedAsync()
    {
        (form, hasStoredPassword, _) = await SmtpSettings.LoadFormAsync();
        var state = await AuthenticationState.GetAuthenticationStateAsync();
        testRecipient = state.User.Identity?.Name;
    }

    private void ChangeSecurity(SmtpSecurity value)
    {
        form!.Security = value;
        // Übliche Ports mitziehen, eigene Ports nicht anfassen.
        if (form.Port is 25 or 465 or 587)
        {
            form.Port = value == SmtpSecurity.SslOnConnect ? 465 : 587;
        }
    }

    private async Task SaveAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        saved = false;
        try
        {
            await SmtpSettings.SaveAsync(form!);
            // Das Passwort verlässt danach den Speicher der Seite.
            (form, hasStoredPassword, _) = await SmtpSettings.LoadFormAsync();
            saved = true;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SendTestAsync()
    {
        // „disabled“ erreicht den Browser erst nach dem Rundlauf – ein Doppelklick schickte sonst zwei Testmails.
        if (busy)
        {
            return;
        }

        busy = true;
        testResult = null;
        try
        {
            testResult = await Mail.SendTestAsync(form!, testRecipient);
        }
        finally
        {
            busy = false;
        }
    }
}
