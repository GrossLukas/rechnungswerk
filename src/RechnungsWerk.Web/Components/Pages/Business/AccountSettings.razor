@page "/einstellungen/konto"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager

<PageTitle>Konto – RechnungsWerk</PageTitle>

<PageHeader Title="Einstellungen" />
<SettingsNav />

<EditForm Model="Input" method="post" OnSubmit="ChangePasswordAsync" FormName="change-password" novalidate class="form">
    <ModelValidator />
    <fieldset class="section">
        <legend>Konto</legend>
        <div class="field">
            <label>
                <span class="field-label">E-Mail</span>
                <input type="email" value="@email" readonly />
            </label>
        </div>
        <Field Label="Aktuelles Passwort" For="() => Input.CurrentPassword" Error="@currentPasswordError">
            <InputText type="password" @bind-Value="Input.CurrentPassword" autocomplete="current-password" />
        </Field>
        <Field Label="Neues Passwort" For="() => Input.NewPassword" Error="@newPasswordError">
            <InputText type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" />
        </Field>
        <Field Label="Neues Passwort wiederholen" For="() => Input.ConfirmPassword">
            <InputText type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
        </Field>
    </fieldset>
    <div class="form-actions">
        @if (changed)
        {
            <span class="saved" role="status">Passwort geändert</span>
        }
        <button type="submit" class="button button-primary">Passwort ändern</button>
    </div>
</EditForm>

@* Auf schmalen Bildschirmen gibt es keine Seitenleiste – dort wird hier abgemeldet. *@
<form action="abmelden" method="post" class="mobile-only form-actions">
    <AntiforgeryToken />
    <button type="submit" class="button button-secondary">Abmelden</button>
</form>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "change-password")]
    private PasswordForm Input { get; set; } = default!;

    private string? email;
    private string? currentPasswordError;
    private string? newPasswordError;
    private bool changed;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new PasswordForm();
        email = (await UserManager.GetUserAsync(HttpContext.User))?.Email;
    }

    private async Task ChangePasswordAsync(EditContext context)
    {
        try
        {
            if (!context.Validate())
            {
                return;
            }

            var user = await UserManager.GetUserAsync(HttpContext.User);
            if (user is null)
            {
                currentPasswordError = "Dein Konto wurde nicht gefunden. Bitte melde dich neu an.";
                return;
            }

            var result = await UserManager.ChangePasswordAsync(user, Input.CurrentPassword, Input.NewPassword);
            if (!result.Succeeded)
            {
                currentPasswordError = string.Join(" ", result.Errors.Where(e => e.Code == nameof(IdentityErrorDescriber.PasswordMismatch)).Select(e => e.Description));
                newPasswordError = string.Join(" ", result.Errors.Where(e => e.Code != nameof(IdentityErrorDescriber.PasswordMismatch)).Select(e => e.Description));
                return;
            }

            await SignInManager.RefreshSignInAsync(user);
            changed = true;
        }
        finally
        {
            // Passwörter nie zurück in die Seite schreiben.
            Input.CurrentPassword = "";
            Input.NewPassword = "";
            Input.ConfirmPassword = "";
        }
    }

    private sealed class PasswordForm
    {
        [Display(Name = "Aktuelles Passwort"), Required(ErrorMessage = "Bitte gib dein aktuelles Passwort ein.")]
        public string CurrentPassword { get; set; } = "";

        [Display(Name = "Neues Passwort"), Required(ErrorMessage = "Bitte gib ein neues Passwort ein."), StringLength(200, ErrorMessage = "Das Passwort ist zu lang.")]
        public string NewPassword { get; set; } = "";

        [Display(Name = "Neues Passwort wiederholen"), Compare(nameof(NewPassword), ErrorMessage = "Die Passwörter stimmen nicht überein.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
