@page "/einstellungen/konto"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager

<PageTitle>Konto – RechnungsWerk</PageTitle>

<SettingsNav />

<div class="page-header">
    <div>
        <h1>Konto</h1>
        <p class="lead">Angemeldet als <strong>@email</strong>.</p>
    </div>
</div>

<section class="card narrow-card">
    <h2>Passwort ändern</h2>

    @if (changed)
    {
        <div class="alert alert-success" role="status">Dein Passwort wurde geändert. Andere Sitzungen werden abgemeldet.</div>
    }

    <ErrorList Errors="errors" />

    <EditForm Model="Input" method="post" OnSubmit="ChangePasswordAsync" FormName="change-password" novalidate class="form">
        <ModelValidator />
        <div class="field">
            <label for="current-password">Bisheriges Passwort</label>
            <InputText id="current-password" type="password" @bind-Value="Input.CurrentPassword" autocomplete="current-password" />
            <ValidationMessage For="() => Input.CurrentPassword" />
        </div>
        <div class="field">
            <label for="new-password">Neues Passwort</label>
            <InputText id="new-password" type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" aria-describedby="new-password-hint" />
            <small id="new-password-hint" class="hint">Mindestens 12 Zeichen mit mindestens einer Ziffer und einem Kleinbuchstaben.</small>
            <ValidationMessage For="() => Input.NewPassword" />
        </div>
        <div class="field">
            <label for="confirm-password">Neues Passwort wiederholen</label>
            <InputText id="confirm-password" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
            <ValidationMessage For="() => Input.ConfirmPassword" />
        </div>
        <button type="submit" class="btn btn-primary">Passwort ändern</button>
    </EditForm>
</section>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "change-password")]
    private PasswordForm Input { get; set; } = default!;

    private string? email;
    private IReadOnlyList<string>? errors;
    private bool changed;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new PasswordForm();
        email = (await UserManager.GetUserAsync(HttpContext.User))?.Email;
    }

    private async Task ChangePasswordAsync(EditContext context)
    {
        try
        {
            if (!context.Validate())
            {
                return;
            }

            var user = await UserManager.GetUserAsync(HttpContext.User);
            if (user is null)
            {
                errors = ["Dein Konto wurde nicht gefunden. Bitte melde dich neu an."];
                return;
            }

            var result = await UserManager.ChangePasswordAsync(user, Input.CurrentPassword, Input.NewPassword);
            if (!result.Succeeded)
            {
                errors = result.Errors.Select(e => e.Description).ToList();
                return;
            }

            await SignInManager.RefreshSignInAsync(user);
            changed = true;
        }
        finally
        {
            // Passwörter nie zurück in die Seite schreiben.
            Input.CurrentPassword = "";
            Input.NewPassword = "";
            Input.ConfirmPassword = "";
        }
    }

    private sealed class PasswordForm
    {
        [Display(Name = "Bisheriges Passwort"), Required(ErrorMessage = "Bitte gib dein bisheriges Passwort ein.")]
        public string CurrentPassword { get; set; } = "";

        [Display(Name = "Neues Passwort"), Required(ErrorMessage = "Bitte gib ein neues Passwort ein."), StringLength(200, ErrorMessage = "Das Passwort ist zu lang.")]
        public string NewPassword { get; set; } = "";

        [Display(Name = "Neues Passwort wiederholen"), Compare(nameof(NewPassword), ErrorMessage = "Die Passwörter stimmen nicht überein.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
