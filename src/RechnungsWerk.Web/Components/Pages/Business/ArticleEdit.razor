@page "/artikel/neu"
@page "/artikel/{Id:int}"
@rendermode AppRenderModes.Live
@inject ArticleService Articles
@inject NavigationManager Navigation

<DocumentTitle Text="@Title" />

@if (loading)
{
    return;
}

@if (notFound)
{
    <PageHeader Title="Artikel nicht gefunden" />
    <EmptyState Text="Diesen Artikel gibt es nicht mehr." ActionText="Zu den Artikeln" ActionHref="artikel" />
    return;
}

<PageHeader Title="@Title" />

<EditForm Model="form" OnValidSubmit="SaveAsync" novalidate class="form">
    <ModelValidator />
    <Field Label="Bezeichnung" For="() => form.Name"><InputText @bind-Value="form.Name" /></Field>
    <Field Label="Beschreibung" For="() => form.Description"><InputTextArea @bind-Value="form.Description" rows="2" /></Field>
    <Field Label="Einheit" For="() => form.UnitCode">
        <InputSelect @bind-Value="form.UnitCode">
            @foreach (var (unitCode, unitLabel) in UnitCodes.Common)
            {
                <option value="@unitCode">@unitLabel</option>
            }
        </InputSelect>
    </Field>
    <Field Label="Preis netto (€)" For="() => form.UnitPrice"><DecimalInput @bind-Value="form.UnitPrice" /></Field>
    <Field Label="Umsatzsteuer" For="() => form.VatRate">
        <InputSelect @bind-Value="form.VatRate">
            @foreach (var rate in VatRates.Allowed)
            {
                <option value="@rate">@rate %</option>
            }
        </InputSelect>
    </Field>

    <FormErrors Messages="errors" />
    <div class="form-actions">
        @if (Id is not null)
        {
            @if (confirmDelete)
            {
                <span class="confirm">
                    <button type="button" class="button button-danger" @onclick="DeleteAsync">Wirklich löschen</button>
                    <button type="button" class="button button-plain" @onclick="CancelDelete">Abbrechen</button>
                </span>
            }
            else
            {
                <button type="button" class="button button-plain button-danger-text" @onclick="AskDelete">Löschen</button>
            }
        }
        <button type="submit" class="button button-primary" aria-disabled="@(saving ? "true" : null)">Speichern</button>
    </div>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private ArticleForm form = new();
    private string? name;
    private IReadOnlyList<string>? errors;
    private bool loading = true;
    private bool notFound;
    private bool saving;
    private bool confirmDelete;

    private string Title => Id is null ? "Neuer Artikel" : name ?? "Artikel";

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        if (Id is { } id)
        {
            var article = await Articles.GetAsync(id);
            notFound = article is null;
            form = article is null ? new ArticleForm() : ArticleForm.From(article);
            name = article?.Name;
        }

        loading = false;
    }

    private async Task SaveAsync()
    {
        // „disabled“ erreicht den Browser erst nach dem Rundlauf – ein Doppelklick käme sonst zweimal an.
        if (saving)
        {
            return;
        }

        saving = true;
        var result = await Articles.SaveAsync(Id, form);
        if (result.Succeeded)
        {
            // Gesperrt lassen, bis der Browser die Liste zeigt – auch ein später zweiter Klick legt nichts mehr an.
            Navigation.NavigateTo("artikel");
            return;
        }

        errors = result.Errors;
        saving = false;
    }

    private void AskDelete()
    {
        confirmDelete = true;
        FocusAfterRender(".form-actions .confirm .button-plain");
    }

    private void CancelDelete()
    {
        confirmDelete = false;
        FocusAfterRender(".form-actions .button-danger-text");
    }

    private async Task DeleteAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        if (Id is { } id)
        {
            await Articles.DeleteAsync(id);
        }

        Navigation.NavigateTo("artikel");
    }
}
