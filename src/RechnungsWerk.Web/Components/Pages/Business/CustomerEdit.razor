@page "/kunden/neu"
@page "/kunden/{Id:int}"
@rendermode AppRenderModes.Live
@inject CustomerService Customers
@inject NavigationManager Navigation

<DocumentTitle Text="@Title" />

@if (loading)
{
    return;
}

@if (notFound)
{
    <PageHeader Title="Kunde nicht gefunden" />
    <EmptyState Text="Diesen Kunden gibt es nicht mehr." ActionText="Zu den Kunden" ActionHref="kunden" />
    return;
}

<PageHeader Title="@Title" />

<EditForm Model="form" OnValidSubmit="SaveAsync" novalidate class="form">
    <ModelValidator />
    <fieldset class="section">
        <legend>Anschrift</legend>
        <Field Label="Name" For="() => form.Name"><InputText @bind-Value="form.Name" /></Field>
        <Field Label="Straße" For="() => form.Street"><InputText @bind-Value="form.Street" /></Field>
        <div class="field-row">
            <Field Label="PLZ" For="() => form.PostalCode"><InputText @bind-Value="form.PostalCode" inputmode="numeric" /></Field>
            <Field Label="Ort" For="() => form.City"><InputText @bind-Value="form.City" /></Field>
        </div>
        <Field Label="Land" For="() => form.CountryCode"><InputText @bind-Value="form.CountryCode" maxlength="2" /></Field>
    </fieldset>

    <fieldset class="section">
        <legend>Rechnungsempfang</legend>
        <Field Label="E-Mail" For="() => form.Email"><InputText type="email" @bind-Value="form.Email" /></Field>
        <Field Label="Leitweg-ID" For="() => form.LeitwegId"><InputText @bind-Value="form.LeitwegId" class="mono" spellcheck="false" /></Field>
        <Field Label="Ansprechperson" For="() => form.ContactName"><InputText @bind-Value="form.ContactName" /></Field>
        <Field Label="Käuferreferenz" For="() => form.BuyerReference"><InputText @bind-Value="form.BuyerReference" /></Field>
        <Field Label="USt-IdNr." For="() => form.VatId"><InputText @bind-Value="form.VatId" /></Field>
        <Field Label="Kundennummer" For="() => form.CustomerNumber"><InputText @bind-Value="form.CustomerNumber" /></Field>
    </fieldset>

    <FormErrors Messages="errors" />
    <div class="form-actions">
        @if (Id is not null)
        {
            @if (confirmDelete)
            {
                <span class="confirm">
                    <button type="button" class="button button-danger" @onclick="DeleteAsync">Wirklich löschen</button>
                    <button type="button" class="button button-plain" @onclick="CancelDelete">Abbrechen</button>
                </span>
            }
            else
            {
                <button type="button" class="button button-plain button-danger-text" @onclick="AskDelete">Löschen</button>
            }
        }
        <button type="submit" class="button button-primary" aria-disabled="@(saving ? "true" : null)">Speichern</button>
    </div>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private CustomerForm form = new();
    private string? name;
    private IReadOnlyList<string>? errors;
    private bool loading = true;
    private bool notFound;
    private bool saving;
    private bool confirmDelete;

    private string Title => Id is null ? "Neuer Kunde" : name ?? "Kunde";

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        if (Id is { } id)
        {
            var customer = await Customers.GetAsync(id);
            notFound = customer is null;
            form = customer is null ? new CustomerForm() : CustomerForm.From(customer);
            name = customer?.Name;
        }

        loading = false;
    }

    private async Task SaveAsync()
    {
        // Der Knopf sperrt nur per aria-disabled, damit er den Fokus behält – ein Doppelklick käme sonst zweimal an.
        if (saving)
        {
            return;
        }

        saving = true;
        var result = await Customers.SaveAsync(Id, form);
        if (result.Succeeded)
        {
            // Gesperrt lassen, bis der Browser die Liste zeigt – auch ein später zweiter Klick legt nichts mehr an.
            Navigation.NavigateTo("kunden");
            return;
        }

        errors = result.Errors;
        saving = false;
    }

    private void AskDelete()
    {
        confirmDelete = true;
        FocusAfterRender(".form-actions .confirm .button-plain");
    }

    private void CancelDelete()
    {
        confirmDelete = false;
        FocusAfterRender(".form-actions .button-danger-text");
    }

    private async Task DeleteAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        if (Id is { } id)
        {
            await Customers.DeleteAsync(id);
        }

        Navigation.NavigateTo("kunden");
    }
}
