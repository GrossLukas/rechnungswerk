@page "/einstellungen/firma"
@rendermode AppRenderModes.Live
@inject CompanyService Companies

<DocumentTitle Text="Firma" />

<PageHeader Title="Einstellungen" />
<SettingsNav />

@if (form is not null)
{
    <EditForm Model="form" OnValidSubmit="SaveAsync" novalidate class="form">
        <ModelValidator />
        <CompanyFields Model="form" />
        <div class="form-actions">
            @if (saved)
            {
                <span class="saved" role="status">Gespeichert</span>
            }
            <button type="submit" class="button button-primary" disabled="@saving">Speichern</button>
        </div>
    </EditForm>
}

@code {
    private CompanyForm? form;
    private bool saving;
    private bool saved;

    protected override async Task OnInitializedAsync()
    {
        var profile = await Companies.GetAsync();
        form = profile is null ? new CompanyForm() : CompanyForm.From(profile);
    }

    private async Task SaveAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        saved = false;
        try
        {
            await Companies.SaveAsync(form!);
            saved = true;
        }
        finally
        {
            saving = false;
        }
    }
}
