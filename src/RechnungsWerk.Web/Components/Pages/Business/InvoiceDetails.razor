@page "/rechnungen/{Id:int}"
@rendermode AppRenderModes.Live
@inject InvoiceService Invoices
@inject InvoiceMailService Mail
@inject EInvoiceReader Reader
@inject KositValidatorClient Validator
@inject NavigationManager Navigation
@inject ILogger<InvoiceDetails> Logger

<PageTitle>@(invoice?.Number ?? "Rechnung") – RechnungsWerk</PageTitle>

@if (loading)
{
    return;
}

@if (invoice is null)
{
    <PageHeader Title="Rechnung nicht gefunden" />
    <EmptyState Text="Diese Rechnung gibt es nicht mehr." ActionText="Zu den Rechnungen" ActionHref="rechnungen" />
    return;
}

<PageHeader Title="@invoice.Number">
    <Action>
        @if (!sendOpen)
        {
            <button type="button" class="button button-primary" @onclick="OpenSend">@(invoice.SentAt is null ? "Senden" : "Erneut senden")</button>
        }
    </Action>
</PageHeader>

<div class="toolbar no-print">
    @if (!invoice.IsLocked)
    {
        <a class="button button-plain" href="@($"rechnungen/{invoice.Id}/bearbeiten")">Bearbeiten</a>
    }
    @if (renderError is null)
    {
        @foreach (var format in Enum.GetValues<EInvoiceFormat>())
        {
            <a class="button button-plain" href="@($"rechnungen/{invoice.Id}/datei/{format}")" download data-enhance-nav="false">@ShortLabel(format)</a>
        }
    }
    @if (Validator.IsConfigured && renderError is null)
    {
        <button type="button" class="button button-plain" @onclick="ValidateAllAsync" disabled="@checking">Prüfen</button>
    }
    <button type="button" class="button button-plain" data-print>Drucken</button>
    @if (!invoice.IsLocked)
    {
        @if (confirmDelete)
        {
            <span class="confirm">
                <button type="button" class="button button-danger" @onclick="DeleteAsync">Wirklich löschen</button>
                <button type="button" class="button button-plain" @onclick="() => confirmDelete = false">Abbrechen</button>
            </span>
        }
        else
        {
            <button type="button" class="button button-plain button-danger-text" @onclick="() => confirmDelete = true">Löschen</button>
        }
    }
</div>

@if (invoice.SentAt is not null)
{
    <p class="status-line no-print"><span class="status status-done">Versendet</span> @Display.Timestamp(invoice.SentAt) an @invoice.SentTo · @invoice.SentFormat?.Label()</p>
}

@if (sendOpen)
{
    <section class="panel no-print" aria-label="Rechnung senden">
        <div class="field-row">
            <div class="field">
                <label>
                    <span class="field-label">An</span>
                    <input type="email" @bind="recipient" autocomplete="email" />
                </label>
                @if (sendResult?.ErrorFor(InvoiceMailService.RecipientField) is { } recipientError)
                {
                    <p class="field-error" role="alert">@recipientError</p>
                }
            </div>
            <div class="field">
                <label>
                    <span class="field-label">Format</span>
                    <select @bind="sendFormat">
                        @foreach (var format in Enum.GetValues<EInvoiceFormat>())
                        {
                            <option value="@format">@format.Label()</option>
                        }
                    </select>
                </label>
            </div>
        </div>
        <FormErrors Messages="sendResult?.GeneralErrors" />
        <div class="form-actions">
            <button type="button" class="button button-plain" @onclick="() => sendOpen = false">Abbrechen</button>
            <button type="button" class="button button-primary" @onclick="SendAsync" disabled="@sending">@(sending ? "Wird gesendet …" : "Senden")</button>
        </div>
    </section>
}
else if (invoice.LastMailError is not null && invoice.SentAt is null)
{
    <p class="form-error no-print" role="alert">@invoice.LastMailError</p>
}

@if (checkError is not null)
{
    <p class="form-error no-print" role="alert">@checkError</p>
}

@if (reports.Count > 0)
{
    <section class="checks no-print" aria-label="Prüfergebnis">
        <ul class="list" role="list">
            @foreach (var (format, report) in reports)
            {
                <li class="check-row">
                    <span>@format.Label()</span>
                    <span class="status @(report.IsAcceptable ? "status-done" : "status-error")">@(report.IsAcceptable ? "Gültig" : "Nicht gültig")</span>
                </li>
            }
        </ul>
        @foreach (var (format, report) in reports.Where(r => !r.Value.IsAcceptable || r.Value.WarningCount > 0))
        {
            <h2 class="section-title">@format.Label()</h2>
            <ValidationReportView Report="report" HeadingLevel="3" />
        }
    </section>
}

@if (preview is not null)
{
    <InvoiceViewer View="preview" TitleOnlyInPrint="true" />
}
else if (renderError is not null)
{
    <p class="form-error" role="alert">@renderError</p>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Invoice? invoice;
    private InvoiceView? preview;
    private readonly Dictionary<EInvoiceFormat, ValidationReport> reports = [];
    private ServiceResult? sendResult;
    private string? checkError;
    private string? renderError;
    private string? recipient;
    private EInvoiceFormat sendFormat;
    private bool loading = true;
    private bool sendOpen;
    private bool sending;
    private bool checking;
    private bool deleting;
    private bool confirmDelete;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        await LoadAsync();
        loading = false;
    }

    private static string ShortLabel(EInvoiceFormat format) => format switch
    {
        EInvoiceFormat.XRechnungUbl => "XRechnung UBL",
        EInvoiceFormat.XRechnungCii => "XRechnung CII",
        _ => "ZUGFeRD-PDF",
    };

    private async Task LoadAsync()
    {
        invoice = await Invoices.GetAsync(Id);
        if (invoice is null)
        {
            return;
        }

        renderError = null;
        try
        {
            // Vorschau aus der erzeugten XRechnung – so, wie sie beim Empfänger ankommt.
            preview = Reader.Read(Invoices.Render(invoice, EInvoiceFormat.XRechnungUbl).Content).View;
        }
        catch (EInvoiceWriteException ex)
        {
            // Z. B. ein Ländercode aus älteren Daten, den keine E-Rechnung kennt.
            preview = null;
            renderError = ex.Message;
        }
        catch (Exception ex) when (ex is EInvoiceReadException or InvalidOperationException or ArgumentException)
        {
            Logger.LogWarning(ex, "Vorschau für Rechnung {InvoiceId} konnte nicht erzeugt werden", Id);
            preview = null;
            renderError = "Die Vorschau dieser Rechnung lässt sich nicht erzeugen.";
        }
    }

    private void OpenSend()
    {
        recipient ??= invoice?.Buyer.Email;
        sendFormat = invoice?.SentFormat ?? invoice?.PreferredFormat ?? EInvoiceFormat.XRechnungUbl;
        sendResult = null;
        sendOpen = true;
    }

    private async Task SendAsync()
    {
        // „disabled“ erreicht den Browser erst nach dem Rundlauf – ein Doppelklick schickte sonst zwei Mails.
        if (sending)
        {
            return;
        }

        sending = true;
        try
        {
            sendResult = await Mail.SendInvoiceAsync(Id, sendFormat, recipient);
            await LoadAsync();
            sendOpen = !sendResult.Succeeded;
        }
        finally
        {
            sending = false;
        }
    }

    private async Task ValidateAllAsync()
    {
        if (invoice is null || checking)
        {
            return;
        }

        checking = true;
        checkError = null;
        reports.Clear();
        try
        {
            foreach (var format in Enum.GetValues<EInvoiceFormat>())
            {
                var file = Invoices.Render(invoice, format);
                reports[format] = await Validator.ValidateAsync(Reader.ExtractXml(file.Content));
            }
        }
        catch (Exception ex) when (ex is ValidatorUnavailableException or EInvoiceWriteException)
        {
            checkError = ex.Message;
        }
        finally
        {
            checking = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (deleting)
        {
            return;
        }

        deleting = true;
        var result = await Invoices.DeleteAsync(Id);
        if (result.Succeeded)
        {
            Navigation.NavigateTo("rechnungen");
            return;
        }

        confirmDelete = false;
        checkError = string.Join(" ", result.Errors);
        deleting = false;
    }
}
