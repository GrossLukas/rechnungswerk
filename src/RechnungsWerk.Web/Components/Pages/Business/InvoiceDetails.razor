@page "/rechnungen/{Id:int}"
@rendermode InteractiveServer
@inject InvoiceService Invoices
@inject InvoiceMailService Mail
@inject EInvoiceReader Reader
@inject KositValidatorClient Validator
@inject NavigationManager Navigation
@inject ILogger<InvoiceDetails> Logger

<PageTitle>Rechnung @invoice?.Number – RechnungsWerk</PageTitle>

@if (loading)
{
    <p class="muted" role="status">Wird geladen …</p>
}
else if (invoice is null)
{
    <section class="narrow">
        <h1>Rechnung nicht gefunden</h1>
        <p class="lead">Diese Rechnung gibt es nicht (mehr).</p>
        <p><a class="btn btn-primary" href="rechnungen">Zur Übersicht</a></p>
    </section>
}
else
{
    <div class="page-header no-print">
        <div>
            <p class="eyebrow"><a href="rechnungen">← Alle Rechnungen</a></p>
            <h1>Rechnung @invoice.Number</h1>
            <p class="lead">@invoice.CustomerName · @GermanFormat.Money(invoice.GrandTotal, invoice.Currency) · <InvoiceStatus Invoice="invoice" /></p>
        </div>
        <div class="actions">
            @if (!invoice.IsLocked)
            {
                <a class="btn btn-secondary" href="@($"rechnungen/{invoice.Id}/bearbeiten")">Bearbeiten</a>
            }
            <button type="button" class="btn btn-secondary" data-print>Drucken</button>
        </div>
    </div>

    <div class="card-grid no-print">
        <section class="card">
            <h2>Herunterladen</h2>
            <ul class="download-list">
                @foreach (var format in Enum.GetValues<EInvoiceFormat>())
                {
                    <li>
                        <a class="btn btn-secondary btn-block" href="@($"rechnungen/{invoice.Id}/datei/{format}")" download data-enhance-nav="false">@format.Label()</a>
                        <small class="hint">@format.Hint()</small>
                    </li>
                }
            </ul>
        </section>

        <section class="card">
            <h2>Per E-Mail senden</h2>
            @if (invoice.SentAt is not null)
            {
                <p class="alert alert-success" role="status">Versendet am @Display.Timestamp(invoice.SentAt) an @invoice.SentTo (@invoice.SentFormat?.Label()).</p>
            }
            @if (sendError is not null)
            {
                <p class="alert alert-error" role="alert">@sendError</p>
            }
            else if (invoice.LastMailError is not null)
            {
                <p class="alert alert-error" role="alert">Versuch am @Display.Timestamp(invoice.LastMailAttemptAt) fehlgeschlagen: @invoice.LastMailError</p>
            }
            <div class="field">
                <label for="send-to">Empfänger</label>
                <input id="send-to" type="email" @bind="recipient" autocomplete="email" />
            </div>
            <div class="field">
                <label for="send-format">Format im Anhang</label>
                <select id="send-format" @bind="sendFormat">
                    @foreach (var format in Enum.GetValues<EInvoiceFormat>())
                    {
                        <option value="@format">@format.Label()</option>
                    }
                </select>
            </div>
            @if (!invoice.IsLocked)
            {
                <p class="hint">Nach dem Versand ist die Rechnung festgeschrieben und lässt sich nicht mehr bearbeiten.</p>
            }
            <button type="button" class="btn btn-primary" @onclick="SendAsync" disabled="@sending">
                @(sending ? "Wird gesendet …" : invoice.SentAt is null ? "Rechnung senden" : "Erneut senden")
            </button>
        </section>

        <section class="card">
            <h2>Offiziell prüfen</h2>
            <p class="hint">Prüft die erzeugte Datei mit dem KoSIT-Validator, bevor du sie verschickst.</p>
            @if (Validator.IsConfigured)
            {
                <div class="field">
                    <label for="check-format">Format</label>
                    <select id="check-format" @bind="checkFormat">
                        @foreach (var format in Enum.GetValues<EInvoiceFormat>())
                        {
                            <option value="@format">@format.Label()</option>
                        }
                    </select>
                </div>
                <button type="button" class="btn btn-secondary" @onclick="ValidateAsync" disabled="@checking">@(checking ? "Wird geprüft …" : "Jetzt prüfen")</button>
            }
            else
            {
                <p class="alert alert-warning">Der Prüfdienst ist auf diesem Server nicht eingerichtet (Einstellung <code>Validator:Url</code>).</p>
            }
        </section>
    </div>

    @if (checkError is not null)
    {
        <div class="alert alert-error no-print" role="alert">@checkError</div>
    }

    @if (report is not null)
    {
        <section class="card no-print">
            <h2>Prüfergebnis: @checkedFormat?.Label()</h2>
            <ValidationReportView Report="report" />
        </section>
    }

    <h2 class="section-title no-print">So sieht der Empfänger die Rechnung</h2>
    @if (preview is not null)
    {
        <InvoiceViewer View="preview" />
    }
    else if (previewError is not null)
    {
        <div class="alert alert-warning">@previewError</div>
    }

    @if (!invoice.IsLocked)
    {
        <section class="danger-zone no-print">
            <h2>Rechnung löschen</h2>
            @if (!confirmDelete)
            {
                <button type="button" class="btn btn-danger-outline" @onclick="() => confirmDelete = true">Rechnung löschen …</button>
            }
            else
            {
                <p>Willst du die Rechnung @invoice.Number wirklich löschen? Die Nummer wird nicht erneut vergeben.</p>
                <div class="form-actions">
                    <button type="button" class="btn btn-danger" @onclick="DeleteAsync">Ja, endgültig löschen</button>
                    <button type="button" class="btn btn-ghost" @onclick="() => confirmDelete = false">Abbrechen</button>
                </div>
            }
        </section>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Invoice? invoice;
    private InvoiceView? preview;
    private string? previewError;
    private ValidationReport? report;
    private EInvoiceFormat? checkedFormat;
    private string? checkError;
    private string? recipient;
    private string? sendError;
    private EInvoiceFormat sendFormat;
    private EInvoiceFormat checkFormat;
    private bool loading = true;
    private bool sending;
    private bool checking;
    private bool confirmDelete;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        await LoadAsync();
        if (invoice is not null)
        {
            recipient = invoice.Buyer.Email;
            sendFormat = invoice.PreferredFormat;
            checkFormat = invoice.PreferredFormat;
        }

        loading = false;
    }

    private async Task LoadAsync()
    {
        invoice = await Invoices.GetAsync(Id);
        if (invoice is null)
        {
            return;
        }

        try
        {
            // Vorschau aus der erzeugten XRechnung – so wie sie beim Empfänger ankommt.
            preview = Reader.Read(Invoices.Render(invoice, EInvoiceFormat.XRechnungUbl).Content).View;
            previewError = null;
        }
        catch (Exception ex) when (ex is EInvoiceReadException or InvalidOperationException or ArgumentException)
        {
            Logger.LogWarning(ex, "Vorschau für Rechnung {InvoiceId} konnte nicht erzeugt werden", Id);
            preview = null;
            previewError = "Die Vorschau konnte nicht erzeugt werden. Prüfe die Rechnung mit „Jetzt prüfen“.";
        }
    }

    private async Task SendAsync()
    {
        if (invoice is null)
        {
            return;
        }

        sending = true;
        try
        {
            var result = await Mail.SendInvoiceAsync(invoice.Id, sendFormat, recipient);
            sendError = result.Succeeded ? null : string.Join(" ", result.Errors);
            await LoadAsync();
        }
        finally
        {
            sending = false;
        }
    }

    private async Task ValidateAsync()
    {
        if (invoice is null)
        {
            return;
        }

        checking = true;
        checkError = null;
        report = null;
        try
        {
            var file = Invoices.Render(invoice, checkFormat);
            report = await Validator.ValidateAsync(Reader.ExtractXml(file.Content));
            checkedFormat = checkFormat;
        }
        catch (ValidatorUnavailableException ex)
        {
            checkError = ex.Message;
        }
        catch (EInvoiceReadException ex)
        {
            checkError = ex.Message;
        }
        finally
        {
            checking = false;
        }
    }

    private async Task DeleteAsync()
    {
        var result = await Invoices.DeleteAsync(Id);
        if (result.Succeeded)
        {
            Navigation.NavigateTo("rechnungen");
            return;
        }

        confirmDelete = false;
        previewError = string.Join(" ", result.Errors);
    }
}
