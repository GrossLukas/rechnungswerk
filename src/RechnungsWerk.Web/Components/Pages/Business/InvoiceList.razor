@page "/rechnungen"
@rendermode AppRenderModes.Live
@inject InvoiceService Invoices
@inject CustomerService Customers

<DocumentTitle Text="Rechnungen" />

<PageHeader Title="Rechnungen">
    <Action>
        @if (invoices is { Count: > 0 })
        {
            <a class="button button-primary" href="rechnungen/neu">Neue Rechnung</a>
        }
    </Action>
</PageHeader>

@if (invoices is null)
{
    return;
}

@if (invoices.Count == 0)
{
    @if (hasCustomers)
    {
        <EmptyState Text="Noch keine Rechnungen." ActionText="Neue Rechnung" ActionHref="rechnungen/neu" />
    }
    else
    {
        <EmptyState Text="Lege zuerst einen Kunden an." ActionText="Neuer Kunde" ActionHref="kunden/neu" />
    }
}
else
{
    <input type="search" class="search" aria-label="Rechnungen durchsuchen" placeholder="Suchen" @bind="search" @bind:event="oninput" />
    <ul class="list" role="list">
        @foreach (var invoice in Filtered)
        {
            <ListRow Href="@($"rechnungen/{invoice.Id}")" Title="@invoice.Number" Detail="@($"{GermanFormat.Date(invoice.IssueDate)} · {invoice.CustomerName}")">
                <Trailing>
                    <span class="amount">@GermanFormat.Money(invoice.GrandTotal, invoice.Currency)</span>
                    <InvoiceStatus Invoice="invoice" />
                </Trailing>
            </ListRow>
        }
    </ul>
    @if (!Filtered.Any())
    {
        <p class="muted">Keine Treffer.</p>
    }
}

@code {
    private List<Invoice>? invoices;
    private bool hasCustomers;
    private string search = "";

    private IEnumerable<Invoice> Filtered
    {
        get
        {
            var term = search.Trim();
            return term.Length == 0
                ? invoices ?? []
                : (invoices ?? []).Where(i => i.Number.Contains(term, StringComparison.OrdinalIgnoreCase)
                                              || i.CustomerName.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        hasCustomers = (await Customers.ListAsync()).Count > 0;
        invoices = await Invoices.ListAsync();
    }
}
