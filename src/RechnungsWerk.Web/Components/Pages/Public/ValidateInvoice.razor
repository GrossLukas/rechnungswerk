@page "/pruefen"
@rendermode InteractiveServer
@inherits PageBase
@inject EInvoiceReader Reader
@inject KositValidatorClient Validator
@inject ILogger<ValidateInvoice> Logger

<PageTitle>Prüfen – RechnungsWerk</PageTitle>

@* Von Anfang an da und leer: Nur so sagen Screenreader spätere Meldungen sicher an. *@
<p class="visually-hidden" role="status">@announcement</p>

<PageHeader Title="Prüfen">
    <Action>
        @if (report is not null)
        {
            <button type="button" class="button button-plain" data-print>Drucken</button>
            <button type="button" class="button button-primary" @onclick="Reset">Andere Datei</button>
        }
    </Action>
</PageHeader>

@if (!Validator.IsConfigured)
{
    <p class="form-error" role="alert">Der Prüfdienst ist auf diesem Server nicht eingerichtet (Einstellung Validator:Url).</p>
}
else if (report is null)
{
    <FormErrors Messages="@(error is null ? null : [error])" />
    <DropZone Id="validate-upload" Busy="busy" OnChange="ValidateAsync" />
}
else
{
    <ValidationReportView Report="report" />
}

@code {
    private ValidationReport? report;
    private string? error;
    private string? announcement;
    private bool busy;

    private async Task ValidateAsync(InputFileChangeEventArgs e)
    {
        error = null;
        announcement = null;
        busy = true;
        try
        {
            report = await BrowserFiles.ProcessAsync(e.File, content => Validator.ValidateAsync(Reader.ExtractXml(content)));
            // Die Ablage ist weg – der Fokus geht an den Anfang des Ergebnisses.
            FocusAfterRender("main h1");
            var groups = string.Join(", ", FindingGroup.Of(report).Select(g => g.Title));
            announcement = (report.IsAcceptable ? "Gültig" : "Nicht gültig") + (groups.Length > 0 ? $": {groups}" : "");
        }
        catch (EInvoiceReadException ex)
        {
            error = ex.Message;
        }
        catch (ValidatorUnavailableException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Fremde Dateien können die Lesebibliotheken an unerwarteten Stellen stolpern lassen – die Sitzung soll weiterlaufen.
            Logger.LogWarning(ex, "Hochgeladene Datei konnte nicht verarbeitet werden");
            error = "Die Datei ist keine lesbare XRechnung und kein ZUGFeRD-PDF.";
        }
        finally
        {
            busy = false;
            if (report is null)
            {
                // Fehler: weiter an der Ablage, die wieder bedienbar ist.
                FocusAfterRender(".dropzone input");
            }
        }
    }

    private void Reset()
    {
        report = null;
        error = null;
        announcement = null;
        FocusAfterRender(".dropzone input");
    }
}
