@page "/anzeigen"
@rendermode InteractiveServer
@inherits PageBase
@inject EInvoiceReader Reader
@inject ILogger<ViewInvoice> Logger

<PageTitle>Anzeigen – RechnungsWerk</PageTitle>

<PageHeader Title="Anzeigen">
    <Action>
        @if (view is not null)
        {
            <button type="button" class="button button-plain" data-print>Drucken</button>
            <button type="button" class="button button-primary" @onclick="Reset">Andere Datei</button>
        }
    </Action>
</PageHeader>

@if (view is null)
{
    <FormErrors Messages="@(error is null ? null : [error])" />
    <DropZone Id="view-upload" Busy="busy" OnChange="LoadAsync" />
}
else
{
    <InvoiceViewer View="view" />
}

@code {
    private InvoiceView? view;
    private string? error;
    private bool busy;

    private async Task LoadAsync(InputFileChangeEventArgs e)
    {
        error = null;
        busy = true;
        try
        {
            // Nur im Arbeitsspeicher: die Datei wird nirgends abgelegt.
            view = await BrowserFiles.ProcessAsync(e.File, content => Task.FromResult(Reader.Read(content).View));
            // Die Ablage ist weg – der Fokus geht an den Anfang des Ergebnisses.
            FocusAfterRender("main h1");
        }
        catch (EInvoiceReadException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Fremde Dateien können die Lesebibliotheken an unerwarteten Stellen stolpern lassen – die Sitzung soll weiterlaufen.
            Logger.LogWarning(ex, "Hochgeladene Datei konnte nicht verarbeitet werden");
            error = "Die Datei ist keine lesbare XRechnung und kein ZUGFeRD-PDF.";
        }
        finally
        {
            busy = false;
            if (view is null)
            {
                // Fehler: weiter an der Ablage, die wieder bedienbar ist.
                FocusAfterRender(".dropzone input");
            }
        }
    }

    private void Reset()
    {
        view = null;
        error = null;
        FocusAfterRender(".dropzone input");
    }
}
