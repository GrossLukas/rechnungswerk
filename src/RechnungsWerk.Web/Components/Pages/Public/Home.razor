@page "/"
@inject SetupService Setup
@inject NavigationManager Navigation

@* Kein Startbildschirm: direkt dorthin, wo die Arbeit wartet. *@
@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var signedIn = AuthenticationState is not null && (await AuthenticationState).User.Identity?.IsAuthenticated == true;
        var target = await Setup.IsSetupRequiredAsync() ? "einrichtung" : signedIn ? "rechnungen" : "anzeigen";
        Navigation.NavigateTo(target);
    }
}
