@inherits LayoutComponentBase
@inject IConfiguration Configuration

<a class="skip-link" href="#main">Zum Inhalt springen</a>

<header class="topbar no-print">
    <div class="topbar-inner">
        <a class="brand" href="">
            <svg class="brand-mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
                <rect x="4" y="2" width="24" height="28" rx="4" fill="#0f62fe" />
                <path d="M10 10h12M10 15h12M10 20h7" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round" />
            </svg>
            <span class="brand-name">RechnungsWerk</span>
        </a>

        <nav class="mainnav" aria-label="Hauptnavigation">
            <NavLink href="anzeigen">Anzeigen</NavLink>
            <NavLink href="pruefen">Prüfen</NavLink>
            <AuthorizeView>
                <NavLink href="rechnungen">Rechnungen</NavLink>
                <NavLink href="kunden">Kunden</NavLink>
                <NavLink href="artikel">Artikel</NavLink>
                <NavLink href="einstellungen">Einstellungen</NavLink>
            </AuthorizeView>
        </nav>

        <div class="account">
            <AuthorizeView>
                <Authorized>
                    <form action="abmelden" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-ghost btn-sm" title="Angemeldet als @context.User.Identity?.Name">Abmelden</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-secondary btn-sm" href="anmelden">Anmelden</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

<main id="main" class="page">
    @Body
</main>

<footer class="footer no-print">
    <p>
        RechnungsWerk ist freie Software unter der AGPL-3.0.
        @if (SourceUrl is not null)
        {
            <a href="@SourceUrl" rel="noopener">Quellcode</a>
        }
        Die offizielle Prüfung nutzt den KoSIT-Validator. Kein Steuer- oder Rechtsrat.
    </p>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    Es ist ein unerwarteter Fehler aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss" role="button" aria-label="Hinweis schließen">✕</span>
</div>

@code {
    private string? SourceUrl => Uri.TryCreate(Configuration["SourceCode:Url"], UriKind.Absolute, out var uri)
        && uri.Scheme is "https" or "http" ? uri.ToString() : null;
}
